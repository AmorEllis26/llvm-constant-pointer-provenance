From e3aa1140a4932601c00dc0d9dfbade2fb0075496 Mon Sep 17 00:00:00 2001
From: Amor Ellis <amorssq26@gmail.com>
Date: Sat, 17 Oct 2026 21:25:15 +0800
Subject: [PATCH 1/2] [Tests] Add minimal constant-pointer provenance cases

Assisted-by: Claude, Codex
---
 .../GVN/constant-pointer-provenance.ll        | 19 ++++++++
 .../SCCP/constant-pointer-provenance.ll       | 44 +++++++++++++++++++
 2 files changed, 63 insertions(+)
 create mode 100644 llvm/test/Transforms/GVN/constant-pointer-provenance.ll
 create mode 100644 llvm/test/Transforms/SCCP/constant-pointer-provenance.ll

diff --git a/llvm/test/Transforms/GVN/constant-pointer-provenance.ll b/llvm/test/Transforms/GVN/constant-pointer-provenance.ll
new file mode 100644
index 000000000..c226528bf
--- /dev/null
+++ b/llvm/test/Transforms/GVN/constant-pointer-provenance.ll
@@ -0,0 +1,19 @@
+; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
+; RUN: opt -S -passes=gvn %s | FileCheck %s
+
+target datalayout = "e-p:64:64-i64:64-n8:16:32:64"
+@a = private unnamed_addr constant <{ [4 x i8], [4 x i8] }> <{ [4 x i8] undef, [4 x i8] zeroinitializer }>, align 4
+declare void @llvm.assume(i1)
+
+define i32 @assume_read(ptr align 4 %p) {
+; CHECK-LABEL: define i32 @assume_read(
+; CHECK-SAME: ptr align 4 [[P:%.*]]) {
+; CHECK-NEXT:    [[EQ:%.*]] = icmp eq ptr [[P]], @a
+; CHECK-NEXT:    call void @llvm.assume(i1 [[EQ]])
+; CHECK-NEXT:    ret i32 undef
+;
+  %eq = icmp eq ptr %p, @a
+  call void @llvm.assume(i1 %eq)
+  %v = load i32, ptr %p, align 4
+  ret i32 %v
+}
diff --git a/llvm/test/Transforms/SCCP/constant-pointer-provenance.ll b/llvm/test/Transforms/SCCP/constant-pointer-provenance.ll
new file mode 100644
index 000000000..cfabcc64e
--- /dev/null
+++ b/llvm/test/Transforms/SCCP/constant-pointer-provenance.ll
@@ -0,0 +1,44 @@
+; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
+; RUN: opt -S -passes=ipsccp %s | FileCheck %s
+
+target datalayout = "e-p:64:64-i64:64-n8:16:32:64"
+@a = private unnamed_addr constant <{ [4 x i8], [4 x i8] }> <{ [4 x i8] undef, [4 x i8] zeroinitializer }>, align 4
+
+define i32 @branch_read(ptr %p) {
+; CHECK-LABEL: define i32 @branch_read(
+; CHECK-SAME: ptr [[P:%.*]]) {
+; CHECK-NEXT:    [[EQ:%.*]] = icmp eq ptr [[P]], @a
+; CHECK-NEXT:    br i1 [[EQ]], label %[[YES:.*]], label %[[NO:.*]]
+; CHECK:       [[YES]]:
+; CHECK-NEXT:    ret i32 undef
+; CHECK:       [[NO]]:
+; CHECK-NEXT:    ret i32 0
+;
+  %eq = icmp eq ptr %p, @a
+  br i1 %eq, label %yes, label %no
+yes:
+  %v = load i32, ptr %p, align 4
+  ret i32 %v
+no:
+  ret i32 0
+}
+
+define i32 @gep_read(ptr %p) {
+; CHECK-LABEL: define i32 @gep_read(
+; CHECK-SAME: ptr [[P:%.*]]) {
+; CHECK-NEXT:    [[EQ:%.*]] = icmp eq ptr [[P]], @a
+; CHECK-NEXT:    br i1 [[EQ]], label %[[YES:.*]], label %[[NO:.*]]
+; CHECK:       [[YES]]:
+; CHECK-NEXT:    ret i32 0
+; CHECK:       [[NO]]:
+; CHECK-NEXT:    ret i32 0
+;
+  %eq = icmp eq ptr %p, @a
+  br i1 %eq, label %yes, label %no
+yes:
+  %q = getelementptr i8, ptr %p, i64 4
+  %v = load i32, ptr %q, align 4
+  ret i32 %v
+no:
+  ret i32 0
+}
