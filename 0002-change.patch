From 52a8bf6016a72a706e193e505aade9878bcc280f Mon Sep 17 00:00:00 2001
From: Amor Ellis <amorssq26@gmail.com>
Date: Sat, 17 Oct 2026 21:25:18 +0800
Subject: [PATCH 2/2] [Analysis] Restrict address-equality pointer replacement
 across provenance

Assisted-by: Claude, Codex
---
 llvm/lib/Analysis/Loads.cpp                   | 10 -------
 llvm/lib/Transforms/Utils/SCCPSolver.cpp      |  9 ++++---
 llvm/test/Transforms/GVN/assume-equal.ll      | 26 +++++++++++++------
 .../GVN/constant-pointer-provenance.ll        |  3 ++-
 llvm/test/Transforms/GVN/invariant.group.ll   | 12 ++++++---
 llvm/test/Transforms/InstCombine/select.ll    |  5 +++-
 .../SCCP/constant-pointer-provenance.ll       |  7 +++--
 ...eferenceable-ptr-with-undereferenceable.ll |  5 ++--
 llvm/unittests/Analysis/LoadsTest.cpp         |  2 +-
 9 files changed, 47 insertions(+), 32 deletions(-)

diff --git a/llvm/lib/Analysis/Loads.cpp b/llvm/lib/Analysis/Loads.cpp
index 4df216c51..5d84f9bbe 100644
--- a/llvm/lib/Analysis/Loads.cpp
+++ b/llvm/lib/Analysis/Loads.cpp
@@ -905,16 +905,6 @@ static bool isPointerAlwaysReplaceable(const Value *From, const Value *To,
   if (isa<ConstantPointerNull>(From) &&
       From->getType()->getPointerAddressSpace() == 0)
     return true;
-  // Allow replacement with dereferenceable constants. This is not strictly
-  // correct, but required for vtable assumptions.
-  auto IsBasedOnConstantGlobal = [](const Value *V) {
-    auto *GV = dyn_cast<GlobalVariable>(getUnderlyingObject(V));
-    return GV && GV->isConstant();
-  };
-  if (isa<Constant>(To) && To->getType()->isPointerTy() &&
-      isDereferenceablePointer(To, Type::getInt8Ty(To->getContext()), DL) &&
-      IsBasedOnConstantGlobal(To))
-    return true;
   return getUnderlyingObjectAggressive(From, /*MustPreserveProvenance=*/true) ==
          getUnderlyingObjectAggressive(To, /*MustPreserveProvenance=*/true);
 }
diff --git a/llvm/lib/Transforms/Utils/SCCPSolver.cpp b/llvm/lib/Transforms/Utils/SCCPSolver.cpp
index 114389ff0..5fd8e7151 100644
--- a/llvm/lib/Transforms/Utils/SCCPSolver.cpp
+++ b/llvm/lib/Transforms/Utils/SCCPSolver.cpp
@@ -1874,12 +1874,13 @@ void SCCPInstVisitor::visitGetElementPtrInst(GetElementPtrInst &I) {
   }
 
   if (Constant *C = ConstantFoldInstOperands(&I, Operands, DL)) {
-    mergeInValue(ValueState[&I], &I, ValueLatticeElement::get(C));
+    ValueLatticeElement Result = ValueLatticeElement::get(C);
     // The pointer operand's lattice has found to be a constant, however, the
     // returned pointer of the GEP may not be freely substituted, as it may have
     // been derived from a pointer with potentially different provenance.
     if (PtrMayHaveDifferentProvenance)
-      ValueState[&I].setMayHaveDifferentProvenance(true);
+      Result.setMayHaveDifferentProvenance(true);
+    mergeInValue(ValueState[&I], &I, Result);
   } else
     markOverdefined(&I);
 }
@@ -1949,7 +1950,9 @@ void SCCPInstVisitor::visitLoadInst(LoadInst &I) {
   if (PtrVal.isUnknownOrUndef())
     return; // The pointer is not resolved yet!
 
-  if (SCCPSolver::isConstant(PtrVal)) {
+  // Address equality alone does not establish the provenance needed to read
+  // the replacement object's initializer or tracked value.
+  if (SCCPSolver::isReplaceableConstant(PtrVal)) {
     Constant *Ptr = getConstant(PtrVal, I.getOperand(0)->getType());
     ValueLatticeElement &IV = ValueState[&I];
 
